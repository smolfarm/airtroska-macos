<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>Airtroska</string>
	<key>CFBundleIdentifier</key>
	<string>com.airtroska.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Airtroska</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<key>CFBundleVersion</key>
	<string>7</string>
	<key>CFBundleIconFile</key>
	<string>Airtroska</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- Register as a viewer for common video types so Finder's "Open With", dock-icon
	     drops, and `open -a Airtroska file.mkv` all work. Rank is Alternate: we never
	     want to steal the double-click default from real players. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.matroska.mkv</string>
				<string>org.webmproject.webm</string>
				<string>public.mpeg-4</string>
				<string>com.apple.m4v-video</string>
				<string>com.apple.quicktime-movie</string>
				<string>public.avi</string>
				<string>public.mpeg</string>
			</array>
		</dict>
	</array>
	<!-- MKV and WebM have no system-declared UTIs; import them so the doc types above
	     (and NSOpenPanel filtering) can reference them. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.matroska.mkv</string>
			<key>UTTypeDescription</key>
			<string>Matroska Video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkv</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.webmproject.webm</string>
			<key>UTTypeDescription</key>
			<string>WebM Video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>webm</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- AirPlay device discovery on macOS 14/15+ requires local-network access; without
	     this string the system denies it and the route picker finds no Apple TV / Roku. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Airtroska streams your video to an AirPlay device on your local network.</string>
	<!-- AirPlay receivers advertise over Bonjour; declare the services we browse. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
	</array>
	<!-- The receiver (and AVPlayer) fetch the video over plain HTTP from the Mac's LAN
	     IP. App Transport Security blocks cleartext to routable IPs by default, so allow
	     local networking. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
